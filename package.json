{
  "name": "comem-infradon",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Cours Infrastructure de Données - HEIG-VD / COMEM+",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:01": "slidev cours/01-introduction.md --open",
    "build": "node scripts/build-all.mjs",
    "build:force": "node scripts/build-all.mjs --force",
    "index": "node scripts/generate-index.mjs"
  },
  "dependencies": {
    "@iconify-json/pixelarticons": "^1.2.6",
    "@slidev/cli": "^53.0.0",
    "slidev-theme-pixel": "^2.0.2"
  },
  "slidev": {
    "colorSchema": "both",
    "themeConfig": {
      "primary": "black"
    },
    "defaults": {
      "fonts": {
        "sans": "Plus Jakarta Sans",
        "serif": "Plus Jakarta Sans",
        "mono": "Atkinson Hyperlegible Mono"
      },
      "transition": false,
      "drawings": {
        "persist": false
      }
    }
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.11",
    "@slidev/types": "^53.0.0",
    "playwright-chromium": "^1.63.0"
  }
}
